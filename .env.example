# Report provider: "mock" (default, offline) or "anthropic".
# With "anthropic" but no key, the app falls back to mock reports and logs a warning.
AI_PROVIDER=mock

# Required for live Claude reports. Copy this file to .env.local and fill it in.
ANTHROPIC_API_KEY=

# Comma-separated origins allowed to call /api/ai-report from the browser,
# e.g. the GitHub Pages build.
REPORT_ALLOWED_ORIGINS=

# Static builds only: absolute URL of a deployed /api/ai-report to use instead of
# in-browser mock reports.
NEXT_PUBLIC_REPORT_API=
